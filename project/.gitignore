cd /workspaces/Vanerava

cat > .gitignore <<'EOF'
# Variables de entorno y secretos
.env
.env.*
!.env.example

# Dependencias
node_modules/
**/node_modules/

# Archivos compilados
dist/
**/dist/
dist-ssr/

# Registros
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Archivos locales y temporales
*.local
*.backup
.DS_Store
.vscode/
.idea/
EOF
